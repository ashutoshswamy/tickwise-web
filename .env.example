# Neon: project > Connection details > pooled connection string
DATABASE_URL=postgres://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Firebase web app config (Project settings > General > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Public site URL (checkout return, canonical links, sitemap)
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://tickwise.ashutoshswamy.in

# Dodo Payments. Without these, campaigns go live without charging.
# Create ONE one-time product with "Pay What You Want" on, minimum $5 USD, and put its id here.
# Webhook: https://YOURHOST/api/dodo, event payment.succeeded
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRODUCT_ID=
DODO_ENV=test_mode

# Comma-separated emails allowed into /admin (the email must also be verified)
ADMIN_EMAILS=

# Encrypts developers' bank details. 64 hex chars: openssl rand -hex 32.
# Keep it safe: losing it makes saved details unreadable.
PAYOUT_KEY=

# Shown on the Terms, Privacy and Cookie pages.
NEXT_PUBLIC_CONTACT_EMAIL=
